<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cream"
    android:padding="0dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="54dp">
            <CheckBox
                android:id="@+id/checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:buttonTint="@color/green_brand"/>
            <ImageView
                android:id="@+id/mvIconLogo"
                android:layout_toEndOf="@+id/checkbox"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/cottage_24"/>
            <TextView
                android:id="@+id/tvNameStore"
                android:layout_toEndOf="@+id/mvIconLogo"
                android:layout_toStartOf="@+id/btnEditItemLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Store Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="10dp"/>
            <RelativeLayout
                android:id="@+id/btnEditItemLayout"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_sage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="15dp">
                <TextView
                    android:id="@+id/tvEditItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_en"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_brand"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSubCard"
            android:layout_below="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</RelativeLayout>