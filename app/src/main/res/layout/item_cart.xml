<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="1dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mvImageProduct"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:src="@drawable/qr_code_add_24"
            android:scaleType="fitCenter"
            app:tint="@color/trans_gray" />
        <ImageView
            android:id="@+id/btnCartRemove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="-4dp"
            android:src="@drawable/icon_delete_24"
            app:tint="@color/coral"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvCartProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/product_name_en"
            android:textSize="12sp"
            android:textColor="@color/ink"
            android:maxLines="2"
            android:textStyle="bold"
            android:ellipsize="end"
            android:fontFamily="@font/adlamdisplay_regular" />
        <TextView
            android:id="@+id/tvCartUnitPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="CartUnitPrice"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:textStyle="normal"
            android:fontFamily="@font/adlamdisplay_regular" />
        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="CartSubtotal"
            android:textSize="12sp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:fontFamily="@font/adlamdisplay_regular" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCartMinus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:layout_marginVertical="10dp"
        android:text="-"
        android:textStyle="bold"
        android:fontFamily="@font/adlamdisplay_regular"
        android:backgroundTint="@color/butter"/>
    <TextView
        android:id="@+id/tvCartQuantity"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:gravity="center"
        android:text="1"
        android:fontFamily="@font/adlamdisplay_regular"
        android:textSize="12sp"
        android:textColor="@color/ink"
        android:textStyle="bold"
        android:textAlignment="center"/>
    <Button
        android:id="@+id/btnCartPlus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginVertical="10dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textStyle="bold"
        android:fontFamily="@font/adlamdisplay_regular"
        android:backgroundTint="@color/green_brand"/>
</LinearLayout>