<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/bg_card">

    <TextView
        android:id="@+id/tvImageUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="middle"
        android:text="@string/hint_image_url_th"
        android:fontFamily="@font/adlamdisplay_regular"
        android:textSize="11sp"
        android:textColor="@color/ink"/>

    <TextView
        android:id="@+id/tvPrimaryBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[primary]"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/adlamdisplay_regular"/>

    <LinearLayout
        android:id="@+id/btnDeleteImage"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="end|center_vertical">
        <ImageView
            android:id="@+id/imvDelete"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_delete_24"
            android:layout_marginEnd="10dp"
            app:tint="@color/coral" />
    </LinearLayout>
</LinearLayout>