<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/bg_card">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@color/gray_f6"
        android:contentDescription="@null"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/tvImageUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="middle"
        android:text="@string/hint_image_url_th"
        android:fontFamily="@font/adlamdisplay_regular"
        android:textSize="11sp"
        android:textColor="@color/ink"/>

    <TextView
        android:id="@+id/tvPrimaryBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[primary]"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/adlamdisplay_regular"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnDeleteImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="10dp"
        android:foregroundTint="@color/coral"
        android:foreground="@drawable/icon_delete_24"
        android:textSize="11sp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>