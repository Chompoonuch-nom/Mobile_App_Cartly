<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:elevation="2dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp">
            <RelativeLayout
                android:id="@+id/imageProductLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="UselessParent">
                <ImageView
                    android:id="@+id/mvProduct"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:background="@color/transparent"
                    android:contentDescription="@null" />
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/tvHotSale"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hot_sale_en"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textColor="@color/yellow"
            android:background="@drawable/bg_card"
            android:layout_marginTop="4dp"
            android:padding="6dp"/>
        <RelativeLayout
            android:id="@+id/detailProductLayout"
            android:layout_below="@id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:layout_alignParentBottom="false"
            android:background="@drawable/bg_card">
            <RelativeLayout
                android:id="@+id/adminActionLayout"
                android:visibility="visible"
                android:layout_below="@+id/tvStockProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/mvBtnEditProduct"
                    android:layout_toEndOf="@+id/mvBtnDeleteProduct"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_edit_square_24"
                    app:tint="@color/butter"
                    tools:ignore="ContentDescription" />
                <ImageView
                    android:id="@+id/mvBtnDeleteProduct"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/icon_delete_24"
                    app:tint="@color/coral"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>
            <TextView
                android:id="@+id/tvNameProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/product_name_en"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:textStyle="bold"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_centerHorizontal="true"
                tools:ignore="SmallSp" />
            <TextView
                android:id="@+id/tvDetailProduct"
                android:layout_below="@+id/tvNameProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description_en"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginVertical="2dp"
                android:paddingHorizontal="10dp"
                android:shadowRadius="12"
                android:layout_centerHorizontal="true"
                tools:ignore="SmallSp" />
            <TextView
                android:id="@+id/tvPriceProduct"
                android:layout_below="@+id/tvDetailProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$1.99"
                android:textSize="12sp"
                android:textColor="@color/green_brand"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_marginVertical="4dp"
                android:paddingHorizontal="10dp"
                android:shadowRadius="12"/>
            <TextView
                android:id="@+id/tvTitleStockProduct"
                android:visibility="gone"
                android:layout_below="@+id/tvDetailProduct"
                android:layout_alignBaseline="@id/tvPriceProduct"
                android:layout_toLeftOf="@+id/tvStockProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock : "
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_marginVertical="4dp"
                android:paddingHorizontal="10dp"
                android:shadowRadius="12"/>
            <TextView
                android:id="@+id/tvStockProduct"
                android:layout_below="@+id/tvPriceProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="100"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_marginVertical="4dp"
                android:paddingHorizontal="10dp"
                android:shadowRadius="12"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/mvAddToCart"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:src="@drawable/icon_add_product"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            tools:ignore="ContentDescription" />
    </RelativeLayout>

</LinearLayout>