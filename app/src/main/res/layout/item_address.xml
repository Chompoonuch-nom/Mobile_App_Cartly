<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="1dp">

    <TextView
        android:id="@+id/tvAddressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:text="tvAddressLabel"
        android:textSize="11sp"
        android:fontFamily="@font/adlamdisplay_regular"/>
    <TextView
        android:id="@+id/tvAddressRecipient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:text="tvAddressRecipient"
        android:textSize="11sp"
        android:fontFamily="@font/adlamdisplay_regular"/>
    <TextView
        android:id="@+id/tvAddressFull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:text="tvAddressFull"
        android:textSize="11sp"
        android:fontFamily="@font/adlamdisplay_regular"/>
    <TextView
        android:id="@+id/tvAddressPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="tvAddressPhone"
        android:textSize="11sp"
        android:fontFamily="@font/adlamdisplay_regular"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/btnEditAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="แก้ไข"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTintMode="src_atop"
            android:backgroundTint="@color/butter"/>
        <Button
            android:id="@+id/btnDeleteAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="ลบ"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTintMode="src_atop"
            android:backgroundTint="@color/coral"/>
    </LinearLayout>
</LinearLayout>