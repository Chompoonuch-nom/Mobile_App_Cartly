<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragment.HomeFragment"
    android:background="@color/trans_gray">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingHorizontal="0dp">
            <RelativeLayout
                android:id="@+id/titleLayout"
                android:visibility="gone"
                android:layout_alignBaseline="@id/countOrderLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/mvIconLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_logo"
                    android:layout_marginStart="0dp"/>
                <TextView
                    android:id="@+id/tvTitleScreen"
                    android:layout_toEndOf="@+id/mvIconLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textSize="18sp"
                    android:textColor="@color/green_brand"
                    android:textStyle="bold"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/countOrderLayout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/mvBtnCart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/shopping_cart_24"
                    android:layout_marginTop="15dp"
                    app:tint="@color/green_brand" />
                <TextView
                    android:id="@+id/tvCountOrder"
                    android:layout_toEndOf="@+id/mvBtnCart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="0"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textColor="@color/green_brand"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:foregroundGravity="top"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_sage"
                    tools:ignore="HardcodedText" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/searchLayout"
                android:layout_below="@id/titleLayout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="4dp">
                <ImageView
                    android:id="@+id/mvSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_category_search_24"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    app:tint="@color/trans_gray"
                    tools:ignore="ContentDescription" />
                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_toEndOf="@+id/mvSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="10dp"
                    android:background="@null"
                    android:hint="@string/search_en"
                    android:textSize="16sp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/trans_gray"
                    android:fontFamily="@font/adlamdisplay_regular"
                    tools:ignore="Autofill,TextFields" />
            </RelativeLayout>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>
                <TextView
                    android:id="@+id/btnLoadMore"
                    android:visibility="visible"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_sage"
                    android:padding="10dp"
                    android:layout_marginBottom="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="@string/load_more_en"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/ink"/>
            </RelativeLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>


</FrameLayout>