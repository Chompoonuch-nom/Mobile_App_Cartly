<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_f6"
    tools:context=".ProductFormActivity">

    <com.example.cartly.View.ToolbarView
        android:id="@+id/toolbar"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <EditText
                android:id="@+id/edtProductName"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/product_name_th"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textSize="12sp"
                android:padding="10dp"
                tools:ignore="Autofill,TextFields" />
            <EditText
                android:id="@+id/edtProductDescp"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/product_detail_th"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textSize="12sp"
                android:padding="10dp"
                tools:ignore="Autofill" />
            <EditText
                android:id="@+id/edtProductPrice"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/price_th"
                android:inputType="numberDecimal"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textSize="12sp"
                android:padding="10dp"
                tools:ignore="Autofill" />
            <EditText
                android:id="@+id/edtStockQty"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/stock_qty_th"
                android:inputType="number"
                android:textColorHint="@color/muted"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textSize="12sp"
                android:padding="10dp"
                tools:ignore="Autofill" />
            <!--        Category Select -->
            <TextView
                android:id="@+id/tvTitleCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/category_th"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerCategory"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"/>
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/green_brand"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/save_th"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_marginTop="20dp"/>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutImagesSection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/separator"
                    android:layout_marginVertical="12dp"/>
                <TextView
                    android:id="@+id/tvTitleImageList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/image_product_th"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/layoutImageList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/edtImageUrl"
                            android:background="@drawable/bg_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:hint="@string/hint_image_url_th"
                            android:textColorHint="@color/muted"
                            android:textColor="@color/ink"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="12sp"
                            android:padding="10dp"
                            tools:ignore="Autofill,TextFields" />
                        <Button
                            android:id="@+id/btnPickImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ถ่ายรูป"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/green_brand"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                    <CheckBox
                        android:id="@+id/checkboxIsPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_is_primary_picture_th"
                        android:fontFamily="@font/adlamdisplay_regular"
                        android:textSize="12sp"/>
                    <Button
                        android:id="@+id/btnAddImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/green_brand"
                        android:text="@string/add_image_th"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/adlamdisplay_regular"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>