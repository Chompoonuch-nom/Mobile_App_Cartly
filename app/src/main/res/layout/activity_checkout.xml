<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_f6"
    tools:context=".CheckoutActivity">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_purple"
        android:title="ยืนยันคำสั่งซื้อ"
        android:titleTextColor="@color/white"
        app:titleTextColor="@color/white" />
    <LinearLayout
        android:id="@+id/container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ที่อยู่จัดส่ง"
            android:textStyle="bold"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textColor="@color/ink"
            android:textSize="18sp"/>
        <TextView
            android:id="@+id/tvSelectedAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="@drawable/bg_sage"
            android:text="ยังไม่ได้เลือกที่อยู่ — แตะเพื่อเลือก"
            android:textStyle="normal"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textColor="@color/gray"
            android:textSize="12sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="วิธีชำระเงิน"
            android:textStyle="bold"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textColor="@color/ink"
            android:textSize="18sp"/>

        <RadioGroup
            android:id="@+id/radioPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <RadioButton
                android:id="@+id/rbCod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="เก็บเงินปลายทาง (COD)"
                android:checked="true"
                android:buttonTint="@color/green_brand"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:fontFamily="@font/adlamdisplay_regular"/>
            <RadioButton
                android:id="@+id/rbCreditCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="บัตรเครดิต (CREDIT_CARD)"
                android:checked="false"
                android:buttonTint="@color/green_brand"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:fontFamily="@font/adlamdisplay_regular"/>
            <RadioButton
                android:id="@+id/rbPromptpay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="พร้อมเพย์ (PROMPTPAY)"
                android:checked="false"
                android:buttonTint="@color/green_brand"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:fontFamily="@font/adlamdisplay_regular"/>
            <RadioButton
                android:id="@+id/rbTruemoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="ทรูมันนี่ (TRUEMONEY)"
                android:checked="false"
                android:buttonTint="@color/green_brand"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:fontFamily="@font/adlamdisplay_regular"/>
        </RadioGroup>

        <TextView
            android:id="@+id/tvCheckoutTotal"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="ยอดรวม: ฿0"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textColor="@color/butter"/>

        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTintMode="src_in"
            android:backgroundTint="@color/green_brand"
            android:background="@drawable/bg_sage"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="ยืนยันคำสั่งซื้อ"
            android:textColor="@color/gray_f6"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textStyle="bold"
            android:textSize="14sp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layoutLoading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_overlay">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

</LinearLayout>