<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUpActivity"
    android:background="@color/cream">

    <RelativeLayout
        android:id="@+id/signUpDes"
        android:layout_above="@id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:ignore="UselessParent">
            <RelativeLayout
                android:id="@+id/signUpLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp">
                <TextView
                    android:id="@+id/tvTitleSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/title_sign_up_page_en"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="24sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@color/ink"/>
                <TextView
                    android:id="@+id/tvSubTitleSignUp"
                    android:layout_below="@+id/tvTitleSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sub_title_sign_up_en"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="14sp"
                    android:textColor="@color/muted"/>

                <!--            Sign Up Detail Layout -->
                <RelativeLayout
                    android:id="@+id/signUpDetailLayout"
                    android:visibility="visible"
                    android:layout_below="@id/tvSubTitleSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">

                    <!--                Enter Email Layout -->
                    <RelativeLayout
                        android:id="@+id/EnterEmailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:id="@+id/tvTitleEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_email_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:textStyle="bold"/>
                        <EditText
                            android:id="@+id/edtEnterEmail"
                            android:layout_below="@+id/tvTitleEmail"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:hint="@string/enter_your_email_en"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="20dp"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"/>
                        <RelativeLayout
                            android:id="@+id/warningEmailLayout"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/edtEnterEmail"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningEmail"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningEmail"
                                android:layout_toEndOf="@id/mvWarningEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_enter_email_en"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:layout_centerVertical="true"
                                tools:ignore="SmallSp" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Enter First Name Layout -->
                    <RelativeLayout
                        android:id="@+id/enterFirstNameLayout"
                        android:layout_below="@id/EnterEmailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvTitleFirstName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:text="@string/title_first_name_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>
                        <EditText
                            android:id="@+id/edtEnterFirstName"
                            android:layout_below="@+id/tvTitleFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:inputType="text"
                            android:hint="@string/enter_your_first_name_en"
                            android:textSize="14sp"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"/>
                        <RelativeLayout
                            android:id="@+id/warningFirstNameLayout"
                            android:visibility="gone"
                            android:layout_below="@+id/edtEnterFirstName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningFirstName"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningFirstName"
                                android:layout_toEndOf="@+id/mvWarningFirstName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_enter_your_first_name_en"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:layout_centerVertical="true"
                                tools:ignore="SmallSp" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Enter Last Name Layout -->
                    <RelativeLayout
                        android:id="@+id/enterLastNameLayout"
                        android:layout_below="@+id/enterFirstNameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvTitleLastName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:text="@string/title_last_name_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>
                        <EditText
                            android:id="@+id/edtEnterLastName"
                            android:layout_below="@id/tvTitleLastName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:inputType="text"
                            android:hint="@string/enter_your_last_name_en"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:paddingHorizontal="20dp"/>
                        <RelativeLayout
                            android:id="@+id/warningLastNameLayout"
                            android:visibility="gone"
                            android:layout_below="@+id/edtEnterLastName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningLastName"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningLastName"
                                android:layout_toEndOf="@id/mvWarningLastName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_enter_your_last_name_en"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:layout_centerVertical="true"
                                tools:ignore="SmallSp" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Enter Username Layout -->
                    <RelativeLayout
                        android:id="@+id/enterUsernameLayout"
                        android:layout_below="@+id/enterLastNameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvTitleUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:text="@string/title_user_name_en"
                            android:textSize="14sp"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>
                        <EditText
                            android:id="@+id/edtEnterUsername"
                            android:layout_below="@+id/tvTitleUsername"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:inputType="text"
                            android:hint="@string/hint_enter_username_en"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:paddingHorizontal="20dp"/>
                        <RelativeLayout
                            android:id="@+id/warningUsernameLayout"
                            android:visibility="gone"
                            android:layout_below="@id/edtEnterUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningUsername"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningUsername"
                                android:layout_toEndOf="@+id/mvWarningUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_enter_username_en"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Enter Password Layout -->
                    <RelativeLayout
                        android:id="@+id/enterPasswordLayout"
                        android:layout_below="@+id/enterUsernameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvTitlePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="10dp"
                            android:text="@string/title_password_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>
                        <RelativeLayout
                            android:id="@+id/buttonPasswordLayout"
                            android:layout_below="@+id/tvTitlePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/edtEnterPassword"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input"
                                android:hint="@string/hint_enter_password_en"
                                android:inputType="textPassword"
                                android:paddingHorizontal="20dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted"
                                android:fontFamily="@font/adlamdisplay_regular"/>
                            <ImageView
                                android:id="@+id/mvBtnOpenPassword"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_eye_slash"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="20dp"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/warningPasswordLayout"
                            android:visibility="gone"
                            android:layout_below="@+id/buttonPasswordLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningPassword"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningPassword"
                                android:layout_toEndOf="@id/mvWarningPassword"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_enter_password_en"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Re-enter password layout -->
                    <RelativeLayout
                        android:id="@+id/enterPasswordConfirmLayout"
                        android:layout_below="@+id/enterPasswordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvTitleConfirmPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="10dp"
                            android:text="@string/title_confirm_password_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"/>
                        <RelativeLayout
                            android:id="@+id/buttonConfirmPasswordLayout"
                            android:layout_below="@+id/tvTitleConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/edtReEnterPassword"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input"
                                android:hint="@string/hint_re_enter_password_en"
                                android:inputType="textPassword"
                                android:paddingHorizontal="20dp"
                                android:textSize="14sp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted"
                                android:fontFamily="@font/adlamdisplay_regular"/>
                            <ImageView
                                android:id="@+id/mvBtnOpenPasswordConfirm"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_eye_slash"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="20dp"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/warningConfirmPasswordLayout"
                            android:visibility="gone"
                            android:layout_below="@+id/buttonConfirmPasswordLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:id="@+id/mvWarningConfirmPassword"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/icon_warning_yellow"/>
                            <TextView
                                android:id="@+id/tvWarningConfirmPassword"
                                android:layout_toEndOf="@id/mvWarningConfirmPassword"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/warning_re_enter_password_en"
                                android:textSize="12sp"
                                android:textColor="@color/yellow"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!--                Policy Layout -->
                    <RelativeLayout
                        android:id="@+id/policyLayout"
                        android:layout_below="@+id/enterPasswordConfirmLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp">
                        <CheckBox
                            android:id="@+id/checkboxPolicy"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:backgroundTint="@null"/>
                        <TextView
                            android:id="@+id/tvPolicy"
                            android:layout_toEndOf="@+id/checkboxPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/title_policy_en"
                            android:textSize="14sp"
                            android:textColor="@color/muted"
                            android:fontFamily="@font/adlamdisplay_regular"/>
                        <TextView
                            android:id="@+id/tvBtnTermOfService"
                            android:layout_toEndOf="@+id/tvPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/btn_term_of_service_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/muted"/>
                        <TextView
                            android:id="@+id/tvAnd"
                            android:layout_toEndOf="@+id/checkboxPolicy"
                            android:layout_below="@+id/tvBtnTermOfService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/and_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textColor="@color/muted"/>
                        <TextView
                            android:id="@+id/tvBtnPolicy"
                            android:layout_toEndOf="@+id/tvAnd"
                            android:layout_below="@+id/tvBtnTermOfService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_policy_en"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/muted"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/bottomLayout"
                        android:layout_below="@id/policyLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp"
                        android:layout_alignParentBottom="false"
                        android:padding="0dp"
                        tools:ignore="NotSibling">
                        <RelativeLayout
                            android:id="@+id/btnSignUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:padding="0dp">
                            <ImageView
                                android:id="@+id/mvSignUpIcon"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_sage"/>
                            <TextView
                                android:id="@+id/tvSignUp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="@string/sign_up_en"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink"/>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/btnLogInLayout"
                            android:layout_below="@+id/btnSignUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true">
                                <TextView
                                    android:id="@+id/tvLogin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/already_have_an_account_en"
                                    android:textSize="14sp"
                                    android:textColor="@color/muted"
                                    android:fontFamily="@font/adlamdisplay_regular"/>
                                <TextView
                                    android:id="@+id/tvBtnLogin"
                                    android:layout_toEndOf="@id/tvLogin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="10dp"
                                    android:text="@string/btn_log_in_en"
                                    android:textColor="@color/ink"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/adlamdisplay_regular"/>
                            </RelativeLayout>
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>

<!--        Alert Register Layout -->
    <RelativeLayout
        android:id="@+id/alertSignUpLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/layout_alert_sign_up"
            android:id="@+id/alertSignUp"/>
    </RelativeLayout>
</RelativeLayout>