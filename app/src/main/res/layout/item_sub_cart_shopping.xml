<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_marginBottom="8dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card"
        android:layout_marginVertical="4dp">
        <CheckBox
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:buttonTint="@color/green_brand"/>
        <ImageView
            android:id="@+id/mvImageProduct"
            android:layout_toEndOf="@+id/checkbox"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:src="@drawable/qr_code_add_24"
            android:tint="@color/trans_gray"
            android:scaleType="fitCenter"/>
        <TextView
            android:id="@+id/tvNameProduct"
            android:layout_toEndOf="@+id/mvImageProduct"
            android:layout_above="@+id/tvBath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:text="@string/product_name_en"
            android:textSize="12sp"
            android:textColor="@color/ink"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/adlamdisplay_regular"/>
        <TextView
            android:id="@+id/tvBath"
            android:layout_toEndOf="@+id/mvImageProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="฿"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:fontFamily="@font/adlamdisplay_regular"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="20dp"/>
        <TextView
            android:id="@+id/tvTotal"
            android:layout_toEndOf="@+id/tvBath"
            android:layout_toStartOf="@+id/countLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:fontFamily="@font/adlamdisplay_regular"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_alignParentBottom="true"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="10dp"/>
        <RelativeLayout
            android:id="@+id/countLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp">
            <ImageView
                android:id="@+id/mvBtnCountDown"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_count_down"
                android:background="@drawable/bg_card"
                android:layout_centerVertical="true"
                android:tint="@color/pastel_purple"
                android:padding="2dp"/>
            <TextView
                android:id="@+id/tvCount"
                android:layout_toEndOf="@+id/mvBtnCountDown"
                android:layout_width="60dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_input"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/muted"
                android:textAlignment="center"
                android:fontFamily="@font/adlamdisplay_regular"/>
            <ImageView
                android:id="@+id/mvBtnCountUp"
                android:layout_toEndOf="@+id/tvCount"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_plus"
                android:background="@drawable/bg_card"
                android:padding="2dp"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>