<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_f6"
    tools:context=".Fragment.CartFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/tvEmptyCart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="ตะกร้าว่างเปล่า"
            android:fontFamily="@font/adlamdisplay_regular"
            android:textStyle="bold"
            android:textColor="@color/muted"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/gray_f6">
            <TextView
                android:id="@+id/tvCartTotal"
                android:background="@drawable/bg_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ยอดรวม: ฿0"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/butter"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <Button
                    android:id="@+id/btnClearCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ล้างตะกร้า"
                    android:backgroundTintMode="src_atop"
                    android:backgroundTint="@color/trans_gray"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/muted"
                    tools:ignore="ButtonStyle,HardcodedText" />
                <Button
                    android:id="@+id/btnCheckoutCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="ชำระเงิน"
                    android:backgroundTintMode="src_atop"
                    android:backgroundTint="@color/butter"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/gray_f6"
                    tools:ignore="ButtonStyle,HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>