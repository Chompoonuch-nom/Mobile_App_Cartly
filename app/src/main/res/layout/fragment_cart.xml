<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragment.CartFragment">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cream">
        <RelativeLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="0dp">
            <ImageView
                android:id="@+id/mvBtnArrowBack"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_back_arrow_circle"
                android:layout_centerVertical="true"/>
            <TextView
                android:id="@+id/tvTitlePage"
                android:layout_toEndOf="@+id/mvBtnArrowBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_cart_en"
                android:textSize="14sp"
                android:textColor="@color/ink"
                android:textStyle="normal"
                android:fontFamily="@font/adlamdisplay_regular"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"/>
            <RelativeLayout
                android:id="@+id/btnEditCartLayout"
                android:layout_width="56dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_sage"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="20dp">
                <TextView
                    android:id="@+id/tvEditCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_en"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/green_brand"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="16dp"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/componentLayout"
            android:layout_below="@+id/topBarLayout"
            android:layout_above="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="20dp"
            android:layout_marginVertical="0dp">
            <CheckBox
                android:id="@+id/checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/select_all_en"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:fontFamily="@font/adlamdisplay_regular"
                android:buttonTint="@color/green_brand"/>
            <RelativeLayout
                android:id="@+id/totalLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:id="@+id/tvTitleTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/total_en"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/adlamdisplay_regular"/>
                <TextView
                    android:id="@+id/tvBath"
                    android:layout_toEndOf="@+id/tvTitleTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="฿"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"/>
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_toEndOf="@+id/tvBath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_centerVertical="true"/>
                <RelativeLayout
                    android:id="@+id/btnCheckOutLayout"
                    android:layout_toEndOf="@+id/tvTotal"
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_sage"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:id="@+id/tvCheckOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/check_out_en"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="@color/green_brand"
                        android:fontFamily="@font/adlamdisplay_regular"/>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>