<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/gray_f6"
        tools:ignore="UselessParent">
        <com.example.cartly.View.ToolbarView
            android:id="@+id/toolbar"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivProduct"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:background="@color/cream"
                        android:contentDescription="@null"/>
                    <RelativeLayout
                        android:id="@+id/layoutAdminActions"
                        android:visibility="gone"
                        android:layout_below="@id/ivProduct"
                        android:layout_alignParentEnd="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivBtnEditProduct"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/icon_edit_square_24"
                            android:layout_marginTop="10dp"
                            app:tint="@color/green_brand"
                            tools:ignore="ContentDescription" />
                        <ImageView
                            android:id="@+id/ivBtnDeleteProduct"
                            android:layout_toEndOf="@+id/ivBtnEditProduct"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/icon_delete_24"
                            android:layout_marginTop="10dp"
                            app:tint="@color/coral"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_toStartOf="@id/layoutAdminActions"
                        android:layout_below="@id/ivProduct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="4dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="@string/product_name_en"
                        android:fontFamily="@font/adlamdisplay_regular"
                        android:textColor="@color/ink"/>
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ink"
                    android:text="฿25.00"
                    android:fontFamily="@font/adlamdisplay_regular"
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/tvProductStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="คงเหลือ : 123"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/tvProductDescp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/description_en"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textSize="11sp"
                    android:textColor="@color/muted"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="12dp"
                        android:src="@drawable/icon_count_down"
                        tools:ignore="ContentDescription"
                        android:backgroundTintMode="src_atop"
                        android:background="@drawable/bg_sage"/>
                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_input"
                        android:layout_marginHorizontal="4dp"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/adlamdisplay_regular"
                        android:textColor="@color/ink"
                        tools:ignore="HardcodedText" />
                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_sage"
                        android:src="@drawable/icon_plus"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:id="@+id/btnAddToCart"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_sage"
                            android:layout_gravity="center_horizontal">
                            <TextView
                                android:id="@+id/tvAddToCart"
                                android:layout_centerInParent="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_to_cart_th"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/green_brand"
                                android:fontFamily="@font/adlamdisplay_regular"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="0dp"/>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/separator"
                    android:layout_marginVertical="16dp"/>
                <TextView
                    android:id="@+id/tvReviewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review_product_title_th"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textColor="@color/ink"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:nestedScrollingEnabled="false"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12sp"
                    android:text="@string/rate_product_title_th"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textColor="@color/ink"/>
                <RatingBar
                    android:id="@+id/ratingBarInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:progressTint="@color/butter"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="5"/>
                <EditText
                    android:id="@+id/edtComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/edt_comment_review_hint_th"
                    android:background="@drawable/bg_input"
                    android:padding="8dp"
                    android:textSize="11sp"
                    android:textStyle="normal"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    tools:ignore="Autofill,TextFields" />
                <LinearLayout
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginVertical="10dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_sage"
                        android:layout_gravity="center_horizontal">
                        <TextView
                            android:id="@+id/tvSubmitReview"
                            android:layout_centerInParent="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/submit_review_th"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_brand"
                            android:fontFamily="@font/adlamdisplay_regular"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="0dp"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>