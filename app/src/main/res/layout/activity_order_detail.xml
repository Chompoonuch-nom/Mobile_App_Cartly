<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_f6"
    tools:context=".OrderDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.example.cartly.View.ToolbarView
            android:id="@+id/toolbar"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
        <RelativeLayout
            android:id="@+id/layoutLoading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_overlay">
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/tvOrderIdDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="tvOrderIdDetail"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />
            <TextView
                android:id="@+id/tvOrderStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="tvOrderStatusDetail"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textColor="@color/black"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />
            <TextView
                android:id="@+id/tvOrderDateDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="tvOrderDateDetail"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textColor="@color/black"
                android:layout_marginTop="2dp"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/separator"
                android:layout_marginVertical="12dp"/>

            <LinearLayout
                android:id="@+id/layoutOrderItems"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/separator"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:id="@+id/tvOrderTotalDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="tvOrderTotalDetail"
                android:fontFamily="@font/adlamdisplay_regular"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btnCancelOrder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTintMode="src_atop"
                android:backgroundTint="@color/butter"
                android:text="ยกเลิกคำสั่งซื้อ"
                android:textStyle="bold"
                android:fontFamily="@font/adlamdisplay_regular"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/layoutAdminStatus"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/separator"
                    android:layout_marginVertical="12dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="อัปเดตสถานะ (admin)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/adlamdisplay_regular"
                    tools:ignore="HardcodedText" />
                <Spinner
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
                <Button
                    android:id="@+id/btnUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="บันทึกสถานะ"
                    android:textStyle="bold"
                    android:fontFamily="@font/adlamdisplay_regular"
                    android:backgroundTintMode="src_atop"
                    android:backgroundTint="@color/green_brand"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>